<odoo>
    <record id="smart_clinic_patient_tree_view" model="ir.ui.view">
        <field name="name">smart.clinic.patient.tree</field>
        <field name="model">smart_clinic.patient</field>
        <field name="arch" type="xml">
            <tree string="Patients">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="gender"/>
                <field name="date_of_birth"/>
                <field name="appointment_count"/>
                <field name="company_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="smart_clinic_patient_form_view" model="ir.ui.view">
        <field name="name">smart.clinic.patient.form</field>
        <field name="model">smart_clinic.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_appointments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                        >
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="company_id" invisible="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group groups="base.group_multi_company">
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="address" placeholder="Address"/>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids" readonly="1">
                                <tree>
                                    <field name="company_id" invisible="1"/>
                                    <field name="name"/>
                                    <field name="doctor_id"/>
                                    <field name="appointment_datetime"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="smart_clinic_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">smart_clinic.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start by creating patient profiles for your clinic.
            </p>
        </field>
    </record>
</odoo>
