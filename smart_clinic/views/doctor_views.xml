<odoo>
    <record id="smart_clinic_doctor_tree_view" model="ir.ui.view">
        <field name="name">smart.clinic.doctor.tree</field>
        <field name="model">smart_clinic.doctor</field>
        <field name="arch" type="xml">
            <tree string="Doctors">
                <field name="name"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="availability_note"/>
                <field name="is_available"/>
                <field name="website_published"/>
                <field name="consultation_duration"/>
                <field name="appointment_count"/>
                <field name="company_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="smart_clinic_doctor_form_view" model="ir.ui.view">
        <field name="name">smart.clinic.doctor.form</field>
        <field name="model">smart_clinic.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_appointments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                        >
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialization"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="availability_note"/>
                            <field name="is_available"/>
                            <field name="website_published"/>
                            <field name="consultation_duration"/>
                            <field name="active"/>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group groups="base.group_multi_company">
                        <field name="company_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="bio" placeholder="Short professional introduction"/>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids" readonly="1">
                                <tree>
                                    <field name="company_id" invisible="1"/>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="appointment_datetime"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="smart_clinic_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">smart_clinic.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add doctors and publish their availability for appointments.
            </p>
        </field>
    </record>
</odoo>
